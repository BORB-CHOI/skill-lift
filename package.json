{
  "name": "skill-lift",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Skill이 목적을 달성하는지 실제 프로젝트 전환 과제로 판정하는 평가 도구",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "eval:setup": "tsx scripts/setup.ts",
    "eval:prepare-arms": "tsx scripts/prepare-arms.ts",
    "eval:prepare-fixtures": "tsx scripts/prepare-fixtures.ts",
    "eval:probe-network": "tsx scripts/probe-network.ts",
    "eval:gate": "tsx scripts/gate-project.ts",
    "eval:run": "tsx scripts/run-suite.ts",
    "eval:rescan": "tsx scripts/rescan-checks.ts",
    "eval:grade": "tsx scripts/grade-project.ts",
    "eval:power": "tsx scripts/power.ts",
    "eval:preregister": "tsx scripts/preregister.ts",
    "eval:score": "tsx scripts/score.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.10.0",
    "es-toolkit": "1.53.2",
    "eslint": "^9.17.0",
    "lodash": "4.18.1",
    "prettier": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  }
}
