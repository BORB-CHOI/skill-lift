{
  "name": "skill-route-eval",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Skill의 효과를 대조 실행과 통계 판정으로 평가하는 CLI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "eval:setup": "tsx scripts/setup.ts",
    "eval:build-tasks": "tsx scripts/build-tasks.ts",
    "eval:validate-tasks": "tsx scripts/validate-tasks.ts",
    "eval:prepare-arms": "tsx scripts/prepare-arms.ts",
    "eval:preregister": "tsx scripts/preregister.ts",
    "eval:run": "tsx scripts/run-suite.ts",
    "eval:rescore": "tsx scripts/rescore.ts",
    "eval:find-mismatch": "tsx scripts/find-mismatch.ts",
    "eval:probe-functions": "tsx scripts/probe-functions.ts",
    "eval:verify-reveal": "tsx scripts/verify-reveal.ts",
    "eval:publish-results": "tsx scripts/publish-results.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.10.0",
    "es-toolkit": "1.53.2",
    "eslint": "^9.17.0",
    "lodash": "4.18.1",
    "prettier": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  }
}
